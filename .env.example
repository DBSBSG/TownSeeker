# Copy to .env for local development. pnpm start loads it automatically.
# For hosting, set these in Hostinger's runtime settings instead.
HOST=127.0.0.1
PORT=3000

# Must remain private and persistent, outside src/public_html/build directories.
# Relative paths resolve from the working directory. Use an absolute hosting path.
DATA_DIRECTORY=./var/data

# Exact HTTPS origin, no trailing slash or path. Use local HTTPS for browser login.
APP_ORIGIN=https://townseeker.example
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=

# Do not put HOSTINGER_API_TOKEN here. Store deployment credentials in GitHub Secrets.
